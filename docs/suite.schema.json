{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/webimario85-svg/athena-testlab/blob/main/docs/suite.schema.json",
  "title": "Athena TestLab suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "tests"],
  "properties": {
    "schema_version": {"const": "1"},
    "suite_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,63}$"},
    "tests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"oneOf": [
        {"type": "object", "additionalProperties": false,
         "required": ["id", "kind", "host", "port", "timeout_ms"],
         "properties": {
           "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,63}$"},
           "kind": {"const": "tcp-open"},
           "host": {"enum": ["127.0.0.1", "::1"]},
           "port": {"type": "integer", "minimum": 1, "maximum": 65535},
           "timeout_ms": {"type": "integer", "minimum": 50, "maximum": 120000}
         }},
        {"type": "object", "additionalProperties": false,
         "required": ["id", "kind", "host", "port", "timeout_ms", "send_hex", "expect_hex"],
         "properties": {
           "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,63}$"},
           "kind": {"const": "tcp-exchange"},
           "host": {"enum": ["127.0.0.1", "::1"]},
           "port": {"type": "integer", "minimum": 1, "maximum": 65535},
           "timeout_ms": {"type": "integer", "minimum": 50, "maximum": 120000},
           "send_hex": {"type": "string", "pattern": "^(?:[0-9a-fA-F]{2}){0,256}$"},
           "expect_hex": {"type": "string", "pattern": "^(?:[0-9a-fA-F]{2}){1,256}$"}
         }},
        {"type": "object", "additionalProperties": false,
         "required": ["id", "kind", "host", "port", "timeout_ms", "client_version", "expect"],
         "properties": {
           "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,63}$"},
           "kind": {"const": "rathena-login"},
           "host": {"enum": ["127.0.0.1", "::1"]},
           "port": {"type": "integer", "minimum": 1, "maximum": 65535},
           "timeout_ms": {"type": "integer", "minimum": 50, "maximum": 120000},
           "client_version": {"type": "integer", "minimum": 20000101, "maximum": 20991231},
           "expect": {"enum": ["account-rejected", "accepted"]}
         }},
        {"type": "object", "additionalProperties": false,
         "required": ["id", "kind", "executable", "args", "expect_exit", "timeout_ms"],
         "properties": {
           "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,63}$"},
           "kind": {"const": "process-exit"},
           "executable": {"type": "string", "minLength": 1, "maxLength": 240},
           "args": {"type": "array", "maxItems": 12, "items": {
             "type": "string", "maxLength": 200
           }},
           "expect_exit": {"type": "integer", "minimum": -1000, "maximum": 1000},
           "timeout_ms": {"type": "integer", "minimum": 50, "maximum": 120000}
         }}
      ]}
    }
  }
}
